+public final class OfflineRewards {
+    public static final long GOLD = 100000000000L;
+    public static final int GEMS = 1000000000;
+    public static void onLogin(Player p) {
+        if (p.get_vang() < GOLD) p.update_vang(GOLD-p.get_vang());
+        p.update_ngoc((long)GEMS-p.get_ngoc());
+    }
+    public static void checkIn(Player p) throws IOException {
+        p.update_vang(GOLD);
+        p.update_ngoc((long)GEMS-p.get_ngoc());
+        p.item.char_inventory(5);
+        Service.send_notice_box(p.conn,"Offline: nhận 100 tỷ vàng, ví đủ 1 tỷ ngọc. Có thể điểm danh tiếp ngay.");
+    }
+}
