+package template;
+
+import client.Player;
+import core.Service;
+import core.Util;
+import io.Message;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import map.MapService;
+
+public final class EquippedEffects {
+    public static final byte LANTERN_TYPE = 31;
+    public static final byte AURA_TYPE = 32;
+    public static final int LANTERN_SLOT = 21;
+    public static final int AURA_SLOT = 20;
+
+    private EquippedEffects() {}
+
+    public static void send(Player viewer, Player wearer) throws IOException {
+        display(viewer, wearer, wearer.item.wear[LANTERN_SLOT], 0);
+        display(viewer, wearer, wearer.item.wear[AURA_SLOT], 1);
+    }
+
+    private static void display(Player viewer, Player wearer, Item3 item, int layer) throws IOException {
+        if (item == null || !OfflineSkins.has(item.id)) return;
+        int id = Byte.toUnsignedInt(item.part);
+        int zoom = Math.max(1, Math.min(4, viewer.conn.zoomlv));
+        byte[] effect = Util.loadfile("data/part_char/imgver/x" + zoom + "/111_" + id);
+        int start = 4 + ByteBuffer.wrap(effect).getInt();
+        Message packet = new Message(-49);
+        packet.writer().writeByte(0);
+        packet.writer().writeShort(effect.length - start);
+        packet.writer().write(effect, start, effect.length - start);
+        packet.writer().writeByte(0);
+        packet.writer().writeByte(0);
+        packet.writer().writeByte(id);
+        packet.writer().writeShort(wearer.id);
+        packet.writer().writeByte(0);
+        packet.writer().writeByte(layer);
+        packet.writer().writeShort(Short.MAX_VALUE);
+        packet.writer().writeByte(0);
+        viewer.conn.addmsg(packet);
+        packet.cleanup();
+    }
+
+    public static void remove(Player player, Item3 item, int slot) throws IOException {
+        if (item == null || !OfflineSkins.has(item.id)) return;
+        Message packet = new Message(-49);
+        packet.writer().writeByte(100);
+        packet.writer().writeShort(player.id);
+        packet.writer().writeByte(item.part);
+        packet.writer().writeByte(0);
+        packet.writer().writeByte(slot == AURA_SLOT ? 1 : 0);
+        MapService.send_msg_player_inside(player.map, player, packet, true);
+        packet.cleanup();
+    }
+
+    public static void unequip(Player player, int slot) throws IOException {
+        Item3 item = player.item.wear[slot];
+        if (item == null) {
+            Service.send_notice_box(player.conn, "Bạn chưa trang bị vật phẩm này.");
+            return;
+        }
+        if (player.item.get_bag_able() <= 0 || !player.item.add_item_bag3(item)) {
+            Service.send_notice_box(player.conn, "Hành trang đầy!");
+            return;
+        }
+        player.item.wear[slot] = null;
+        remove(player, item, slot);
+        player.item.char_inventory(3);
+        Service.send_wear(player);
+        Service.send_char_main_in4(player);
+    }
+}
