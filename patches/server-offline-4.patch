+package template;
+
+import java.util.List;
+
+public final class WeaponStats {
+    private static final int[] LOW = {72, 99, 140, 196, 260, 339, 428, 534, 646, 772, 909, 1265, 1473, 1670};
+    private static final int[] HIGH = {76, 104, 149, 202, 270, 349, 439, 546, 659, 786, 926, 1286, 1495, 1688};
+    private static final int[] ASSASSIN_POISON = {72, 99, 140, 196, 260, 339, 428, 534, 646, 772, 909, 1329, 1548, 1750};
+    private static final int[] ASSASSIN_PHYSICAL = {76, 104, 149, 202, 270, 349, 439, 546, 659, 786, 926, 1351, 1570, 1772};
+
+    private WeaponStats() {}
+
+    public static void applyMaximum(ItemTemplate3 item, List<Option> options) {
+        int level = item.getLevel();
+        if (item.getType() < 8 || item.getType() > 11 || item.getColor() != 4
+                || level < 1 || level > 130 || (level != 1 && level % 10 != 0)
+                || ItemSellCoin.isTinhTu(item.getId()) || item.getClazz() < 0 || item.getClazz() > 3) {
+            return;
+        }
+        int grade = level / 10;
+        for (Option option : options) {
+            if (option.id < 0 || option.id > 4) continue;
+            boolean physical = option.id == 0;
+            int[] table = switch (item.getClazz()) {
+                case 0 -> physical ? HIGH : LOW;
+                case 1 -> physical ? ASSASSIN_PHYSICAL : ASSASSIN_POISON;
+                default -> physical ? LOW : HIGH;
+            };
+            option.setParam(table[grade]);
+        }
+    }
+}
