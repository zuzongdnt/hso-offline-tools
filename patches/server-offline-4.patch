+package template;
+
+import core.Util;
+
+public final class TinhTu {
+    private static final int[][] SET_SLOTS = {{1, 6, 7}, {0, 3, 9}, {2, 4, 8}};
+
+    private TinhTu() {}
+
+    public static boolean isHidden(int id) {
+        return id == 128 || id >= 131 && id <= 155 || id >= 164 && id <= 176;
+    }
+
+    public static int activeOption(int id) {
+        if (id == 128) return 155;
+        if (id >= 131 && id <= 142) return id + 12;
+        if (id == 164 || id == 166 || id == 168 || id == 171 || id == 173 || id == 175) return id + 1;
+        return id;
+    }
+
+    public static boolean groupIsComplete(Item3[] worn, int slot) {
+        for (int[] group : SET_SLOTS) {
+            for (int member : group) {
+                if (slot != member) continue;
+                for (int required : group) {
+                    Item3 item = worn[required];
+                    if (item == null || !(ItemSellCoin.isTinhTu(item.id)
+                            || ((required == 3 || required == 9) && item.id == 3609)
+                            || (required == 4 && item.id == 2940))) return false;
+                }
+                return true;
+            }
+        }
+        return false;
+    }
+
+    public static boolean canUpgrade(Item3 item) {
+        if (item == null || !ItemSellCoin.isTinhTu(item.id) || item.color < 3
+                || client.Item.get_level_tinh_tu(item.level) >= 10) return false;
+        Option durability = option(item, 129);
+        return durability == null || durability.getParam(0) > 0;
+    }
+
+    public static Option option(Item3 item, int id) {
+        for (Option option : item.op) {
+            if (Byte.toUnsignedInt(option.id) == id) return option;
+        }
+        return null;
+    }
+
+    public static int luck(Item3 item) {
+        Option luck = option(item, 130);
+        return luck == null ? 0 : Math.max(0, Math.min(900, luck.getParam(0)));
+    }
+
+    public static boolean rolls(int chance) {
+        return chance > 0 && (chance >= 10000 || Util.random(10000) < chance);
+    }
+
+    public static int rollStat(int maximum) {
+        if (maximum <= 0 || maximum == Integer.MAX_VALUE) return maximum;
+        int minimum = (int) ((maximum * 9L + 9) / 10);
+        return minimum == maximum ? maximum : Util.random(minimum, maximum + 1);
+    }
+}
