+            4668,4669,4670,4671,4672,4673,4674,4675};
+    private static final int OFFER_START = 10000;
+
+    public record Offer(short key, short itemId, int variant, byte color) {
+        public long price() { return 150_000L + color * 50_000L; }
+
+        public Item3 createItem() {
+            ItemTemplate3 t = ItemTemplate3.item.get(itemId);
+            Item3 item = new Item3();
+            item.id = itemId;
+            item.name = t.getName();
+            item.clazz = t.getClazz();
+            item.type = t.getType();
+            item.level = 45;
+            item.icon = t.getIcon();
+            item.color = color;
+            item.part = t.getPart();
+            item.islock = true;
+            item.op = options(t, color, variant);
+            if (color >= 3) {
+                item.op.add(new Option(129,10000));
+                item.op.add(new Option(130,100 * (color - 2)));
+            }
+            return item;
+        }
+
+        public String label() {
+            ItemTemplate3 t = ItemTemplate3.item.get(itemId);
+            String variantName = ItemTemplate3.item.get(modelId(t, 4, variant)).getName();
+            return t.getName() + " (" + variantName + ", " + COLORS[color] + ")";
+        }
+    }
+
+    public static List<Offer> offers(int quality) {
+        List<Offer> offers = new ArrayList<>();
+        for (int i = 0; i < IDS.length; i++) {
+            ItemTemplate3 t = ItemTemplate3.item.get(IDS[i]);
+            int variations = t.getClazz() == 4 ? 8 : 2;
+            for (int v = 0; v < variations; v++) {
+                int key = OFFER_START + (i * 8 + v) * COLORS.length + quality;
+                offers.add(new Offer((short)key,(short)IDS[i],v,(byte)quality));
+            }
+        }
+        return offers;
+    }
+
+    public static Offer findOffer(int key) {
+        int index = key - OFFER_START;
+        if (index < 0 || index >= IDS.length * 8 * COLORS.length) return null;
+        ItemTemplate3 t = ItemTemplate3.item.get(IDS[index / (8 * COLORS.length)]);
+        int variant = index / COLORS.length % 8;
+        if (variant >= (t.getClazz() == 4 ? 8 : 2)) return null;
+        return new Offer((short)key,t.getId(),variant,(byte)(index % COLORS.length));
+    }
+
+    private static int modelId(ItemTemplate3 template, int color, int variant) {
+        int type = template.getType();
+        int first = START_IDS[type];
+        if (type <= 2) first += template.getClazz() * 5 + variant * 20;
+        else if (type >= 8) first += variant * 20;
+        else first += variant * 5;
+        return first + Math.min(color,4);
+    }
