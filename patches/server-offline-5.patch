+    public static void claimRankReward(Player player) throws IOException {
+        synchronized (player) {
+            int points = player.point_active[2];
+            if (points <= 0) {
+                Service.send_notice_box(player.conn, "Hãy thắng ít nhất một trận để có điểm đổi quà.");
+                return;
+            }
+            int bracket = points >= 2520 ? 4 : points >= 1680 ? 3 : points >= 1260 ? 2 : points >= 840 ? 1 : 0;
+            int[] multipliers = {500, 800, 1000, 4000, 5000};
+            int[] caps = {1, 2, 3, 5, 10};
+            String[] titles = {"Lính canh", "Hiệp sĩ tập sự", "Hiệp sĩ nhỏ", "Hiệp sĩ", "Đại Hiệp sĩ"};
+            int chests = Math.min(caps[bracket], Math.max(1, points / 200));
+            int titleId = bracket >= 2 ? 3594 + bracket : -1;
+            int slots = titleId != -1 ? 1 : 0;
+            int existing = player.item.total_item_by_id(4, GOLD_CHEST);
+            if (existing == 0) slots++;
+            if (player.item.get_bag_able() < slots || existing + chests > 32000) {
+                Service.send_notice_box(player.conn, "Hành trang chưa đủ chỗ để đổi quà.");
+                return;
+            }
+            if (titleId != -1) {
+                Item3 title = ItemSellCoin.entry.stream().filter(offer -> offer.id == titleId)
+                        .findFirst().orElseThrow().createItem();
+                player.item.add_item_bag3(title);
+                player.item.char_inventory(3);
+            }
+            long gold = (long) points * multipliers[bracket];
+            player.update_vang(gold);
+            addReward(player, GOLD_CHEST, chests);
+            player.point_active[2] = 0;
+            player.flush();
+            player.item.char_inventory(4);
+            player.item.char_inventory(5);
+            Service.send_notice_box(player.conn, "Mốc " + titles[bracket] + " nhận " + gold + " vàng và "
+                    + chests + " Rương vàng." + (titleId == -1 ? "" : " Trang phục danh hiệu đã vào hành trang."));
+        }
+    }
