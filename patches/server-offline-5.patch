+            case 4667 -> color == 2 ? new int[]{7,3076,14,145,27,1593} : null;
+            case 4668 -> color == 4 ? new int[]{9,2697,14,138,32,447,33,329} : null;
+            case 4669 -> color == 2 ? new int[]{9,2697,23,17}
+                    : color == 3 ? new int[]{23,22,25,22} : null;
+            case 4784 -> color == 5 ? new int[]{10,2697,26,17,36,399} : null;
+            case 4670 -> color == 1 ? new int[]{23,16,24,13,25,16,26,16}
+                    : color == 4 ? new int[]{24,21,34,316} : null;
+            case 4671 -> color == 1 ? new int[]{14,138,23,24} : null;
+            case 4673 -> color == 4 ? new int[]{0,330,33,469,37,2,40,597} : null;
+            case 4674 -> color == 4 ? new int[]{0,319,34,368,37,2,40,597} : null;
+            case 4675 -> color == 4 ? new int[]{1,330,35,336,37,2,40,597} : null;
+            default -> null;
+        };
+        List<Option> options = new ArrayList<>();
+        if (sample == null) {
+            for (Option option : template.getOp()) options.add(new Option(option.id, option.getParam(0)));
