+    public synchronized void sendCampfire(Player player) throws IOException {
+        if (campfire == null || campfire.until() <= System.currentTimeMillis()) return;
+        int zoom = Math.max(1, Math.min(4, player.conn.zoomlv));
+        byte[] effect = Util.loadfile("data/part_char/imgver/x" + zoom + "/111_0");
+        int start = 4 + java.nio.ByteBuffer.wrap(effect).getInt();
+        Message packet = new Message(-49);
+        packet.writer().writeByte(1);
+        packet.writer().writeShort(effect.length - start);
+        packet.writer().write(effect, start, effect.length - start);
+        packet.writer().writeByte(0);
+        packet.writer().writeByte(0);
+        packet.writer().writeByte(0); // native fire sprite
+        packet.writer().writeShort(campfire.x());
+        packet.writer().writeShort(campfire.y());
+        packet.writer().writeByte(0);
+        packet.writer().writeByte(0);
+        packet.writer().writeShort(CAMPFIRE_ACTOR);
+        packet.writer().writeShort(0);
+        packet.writer().writeByte(1); // avoid duplicate actor when the map is refreshed
+        player.conn.addmsg(packet);
+        packet.cleanup();
+    }
+
+    private synchronized void expireCampfire() throws IOException {
+        if (campfire == null || campfire.until() > System.currentTimeMillis()) return;
+        campfire = null;
+        Message packet = new Message(-49);
+        packet.writer().writeByte(101);
+        packet.writer().writeShort(CAMPFIRE_ACTOR);
+        for (Player viewer : players) viewer.conn.addmsg(packet);
+        packet.cleanup();
+    }
