+    public static void addHiddenOptions(Item3 item, int variant, boolean crafted) {
+        if (item.color < 4) return;
+        int[] ids = switch (item.type) {
+            case 0, 1 -> new int[]{147, 148, 149, 146, 145};
+            case 2 -> new int[]{154, 143, 151};
+            case 3 -> new int[]{167, 153, 165};
+            case 4 -> new int[]{167, 169, 152, 170, 172, 174, 176};
+            case 5 -> new int[]{169, 151, 153, 165};
+            case 6 -> new int[]{152, 153, 165};
+            case 8, 9, 10, 11 -> new int[]{155, 143, 170, 172, 174, 176};
+            default -> throw new IllegalArgumentException("Invalid Tinh Tu type " + item.type);
+        };
+        int count = item.color == 4 ? 2 : 3;
+        if (crafted) count = Util.random(count + 1);
+        for (int i = 0; i < count; i++) {
+            int optionId;
+            if (crafted) {
+                int pick = Util.random(i, ids.length);
+                optionId = ids[pick];
+                ids[pick] = ids[i];
+            } else {
+                optionId = ids[(variant + i) % ids.length];
+            }
+            int chance = crafted ? Util.random(10, 300) : 100 + 25 * variant;
+            int value = optionId == 153 || optionId == 169 ? 60_000 : chance;
+            item.op.add(new Option(optionId, value));
+        }
+    }
+
+    public static int displayedOption(int id, boolean active) {
+        id = activeOption(id);
+        if (!active) return id;
+        if (id == 155) return 128;
+        if (id >= 143 && id <= 154) return id - 12;
+        return switch (id) {
+            case 165, 167, 169, 172, 174, 176 -> id - 1;
+            default -> id;
+        };
+    }
