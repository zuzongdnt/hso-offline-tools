+
+    public static int effect(Player player) {
+        if (player.point_active == null || player.point_active.length <= 4 || player.point_active[4] <= 0) return -1;
+        return 93 + Math.min(5, player.point_active[4]);
+    }
+
+    public static void send(Player viewer, Player player) throws IOException {
+        int id = effect(player);
+        if (id < 0) return;
+        if (viewer == player) {
+            for (int previous = 94; previous <= 98; previous++) {
+                if (previous == id) continue;
+                Message remove = new Message(-49);
+                remove.writer().writeByte(100);
+                remove.writer().writeShort(player.id);
+                remove.writer().writeByte(previous);
+                remove.writer().writeByte(0);
+                remove.writer().writeByte(0);
+                viewer.conn.addmsg(remove);
+            }
+        }
+        byte[] effect = Util.loadfile("data/part_char/imgver/x" + Math.max(1, Math.min(4, viewer.conn.zoomlv)) + "/111_" + id);
+        int start = 4 + java.nio.ByteBuffer.wrap(effect).getInt();
+        Message display = new Message(-49);
+        display.writer().writeByte(0);
+        display.writer().writeShort(effect.length - start);
+        display.writer().write(effect, start, effect.length - start);
+        display.writer().writeByte(0);
+        display.writer().writeByte(0);
+        display.writer().writeByte(id);
+        display.writer().writeShort(player.id);
+        display.writer().writeByte(0); // character
+        display.writer().writeByte(0); // foreground
+        display.writer().writeShort(Short.MAX_VALUE);
+        display.writer().writeByte(0); // visual only
+        viewer.conn.addmsg(display);
+    }
