+package template;
+
+import client.Player;
+import core.Util;
+import java.io.FileNotFoundException;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.Set;
+import org.json.simple.JSONArray;
+import org.json.simple.JSONObject;
+import org.json.simple.JSONValue;
+
+/** Imports the private cosmetic catalog before character saves are read. */
+public final class OfflineSkins {
+    private static final Set<Short> items = new HashSet<>();
+    private static JSONArray catalog = new JSONArray();
+
+    public static void loadItems() throws IOException {
+        try {
+            catalog = (JSONArray) JSONValue.parse(new String(Util.loadfile("data/offline-skins.json"), StandardCharsets.UTF_8));
+        } catch (FileNotFoundException missing) {
+            return;
+        }
+        for (Object entry : catalog) {
+            JSONObject row = (JSONObject) entry;
+            short id = number(row, "id").shortValue();
+            boolean pumpkin = id == 3606;
+            if (!pumpkin && id != ItemTemplate3.item.size()) throw new IOException("Unexpected cosmetic ID " + id);
+            ItemTemplate3 item = pumpkin ? ItemTemplate3.item.get(id) : new ItemTemplate3();
+            item.setId(id);
+            item.setName((String) row.get("name"));
+            item.setType(number(row, "type").byteValue());
+            item.setPart(number(row, "part").byteValue());
+            item.setClazz((byte) 4);
+            item.setIcon(number(row, "icon").shortValue());
+            item.setLevel((short) 1);
+            item.setColor((byte) 5);
+            item.setOp(new ArrayList<>());
+            for (Object pair : (JSONArray) row.get("options")) {
+                JSONArray option = (JSONArray) pair;
+                item.getOp().add(new Option(((Number) option.get(0)).intValue(), ((Number) option.get(1)).intValue()));
+            }
+            if (!pumpkin) ItemTemplate3.item.add(item);
+            items.add(id);
+        }
+    }
+
+    public static void loadFashion() {
+        for (Object entry : catalog) {
+            JSONObject row = (JSONObject) entry;
+            JSONArray parts = (JSONArray) row.get("fashion");
+            if (parts == null) continue;
+            Part_fashion fashion = new Part_fashion();
+            fashion.id = number(row, "id").shortValue();
+            fashion.part = new byte[parts.size()];
+            for (int i = 0; i < parts.size(); i++) fashion.part[i] = ((Number) parts.get(i)).byteValue();
+            Part_fashion.entrys.removeIf(old -> old.id == fashion.id);
+            Part_fashion.entrys.add(fashion);
+        }
+    }
+
+    private static Number number(JSONObject row, String field) { return (Number) row.get(field); }
+
+    public static boolean has(short id) { return items.contains(id); }
+
+    public static boolean grant(Player player) {
+        if (!"zuzong".equalsIgnoreCase(player.name) || items.isEmpty() || player.point_active[6] != 0) return false;
+        Set<Short> owned = new HashSet<>();
+        for (Item3[] group : new Item3[][] {player.item.bag3, player.item.wear, player.item.box3}) {
+            for (Item3 item : group) if (item != null) owned.add(item.id);
+        }
+        var outfits = ItemSellCoin.entry.stream().filter(offer -> has(offer.id) && !owned.contains(offer.id)).toList();
+        var mounts = new ArrayList<Short>();
+        for (short id : ItemSellCoin.MOUNTS)
+            if (player.item.total_item_by_id(4, id) == 0) mounts.add(id);
+        if (player.item.get_bag_able() < outfits.size() + mounts.size()) return false;
+        for (ItemSellCoin outfit : outfits) player.item.add_item_bag3(outfit.createItem());
+        for (short id : mounts) {
+            Item47 mount = new Item47();
+            mount.id = id;
+            mount.quantity = 1;
+            player.item.add_item_bag47(4, mount);
+        }
+        player.point_active[6] = 1;
+        return true;
+    }
+}
