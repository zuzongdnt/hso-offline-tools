+package template;
+
+import client.Player;
+import core.Service;
+import java.io.IOException;
+
+public final class HeroArmor {
+    public static final short FIRST_MATERIAL = 474;
+    private static final short FIRST_ARMOR = 4827;
+    private static final int MATERIAL_COUNT = 500;
+    private static final int GOLD = 2_000_000;
+    private static final String[] COLORS = {"bạc", "tím", "xanh", "vàng"};
+    private static final short[] ICONS = {267, 265, 266, 264};
+
+    private HeroArmor() {}
+
+    public static boolean available() {
+        return OfflineSkins.isCraftedArmor(FIRST_ARMOR);
+    }
+
+    public static void installMaterials() throws IOException {
+        if (!available()) return;
+        if (ItemTemplate7.item.size() != FIRST_MATERIAL) throw new IOException("Unexpected armor material IDs");
+        for (int i = 0; i < COLORS.length; i++) {
+            ItemTemplate7 item = new ItemTemplate7();
+            item.setId((short) (FIRST_MATERIAL + i));
+            item.setIcon(ICONS[i]);
+            item.setName(materialName(i));
+            item.setContent("Nguyên liệu chế tạo giáp siêu nhân " + COLORS[i] + ".");
+            item.setPrice(40_000);
+            item.setType((byte) 19);
+            item.setValue((short) 1);
+            ItemTemplate7.item.add(item);
+        }
+    }
+
+    public static String[] choices() {
+        return java.util.Arrays.stream(COLORS).map(color -> "Giáp siêu nhân " + color).toArray(String[]::new);
+    }
+
+    private static String materialName(int color) {
+        return "Hồ quang " + COLORS[color];
+    }
+
+    public static void request(Player player, int color) throws IOException {
+        player.pendingHeroArmor = -1;
+        if (!available() || color < 0 || color >= COLORS.length) return;
+        player.pendingHeroArmor = color;
+        int owned = player.item.total_item_by_id(7, FIRST_MATERIAL + color);
+        Service.send_box_input_yesno(player.conn, 198, "Chế tạo giáp siêu nhân " + COLORS[color]
+                + "?\n" + materialName(color) + " " + owned + "/" + MATERIAL_COUNT
+                + "\nPhí chế tạo 2.000.000 vàng.");
+    }
+
+    public static synchronized void confirm(Player player, boolean accepted) throws IOException {
+        int color = player.pendingHeroArmor;
+        player.pendingHeroArmor = -1;
+        if (!accepted || !available() || color < 0 || color >= COLORS.length) return;
+        short ingredient = (short) (FIRST_MATERIAL + color);
+        if (player.item.total_item_by_id(7, ingredient) < MATERIAL_COUNT || player.get_vang() < GOLD) {
+            Service.send_notice_box(player.conn, "Cần 500 " + materialName(color) + " và 2.000.000 vàng.");
+            return;
+        }
+        if (player.item.get_bag_able() <= 0) {
+            Service.send_notice_box(player.conn, "Cần ô trống trong hành trang.");
+            return;
+        }
+        int id = FIRST_ARMOR + color;
+        Item3 armor = ItemSellCoin.entry.stream().filter(offer -> offer.id == id).findFirst().orElseThrow().createItem();
+        if (!player.item.add_item_bag3(armor)) return;
+        player.item.remove(7, ingredient, MATERIAL_COUNT);
+        player.update_vang(-GOLD);
+        player.item.char_inventory(7);
+        player.item.char_inventory(3);
+        Service.send_notice_box(player.conn, "Chế tạo thành công " + armor.name + ".");
+    }
+}
